---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByCategory, slugify } from '../../lib';

const groups = groupByCategory(await getPosts());
---
<Base title="Writing & Learning" description="Notes and posts by Olive Li.">
  <div class="page-title">
    <h1>Writing &amp; Learning</h1>
    <p>Notes on what I am reading, building and learning.</p>
  </div>
  {groups.length === 0 && <p class="empty">TBD. First posts coming soon.</p>}
  {groups.map(([category, posts]) => (
    <section class="category-section" id={slugify(category)}>
      <h2>{category}</h2>
      <PostList posts={posts} />
    </section>
  ))}
</Base>
