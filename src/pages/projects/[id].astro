---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { findImage, getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const img = findImage('projects', project.id);
const { title, summary, note, tools, github, live } = project.data;
---
<Base title={title} description={summary}>
  <article class="article">
    <a class="back" href="/projects/">← All projects</a>
    <h1>{title}</h1>
    <p class="meta">{summary}</p>
    {note && <p class="notice">{note}</p>}
    {img && <img class={img.endsWith('.gif') ? 'hero pixel' : 'hero'} src={img} alt={`Screenshot of ${title}`} />}

    <Content />

    {tools.length > 0 && (
      <>
        <h2>Tools used</h2>
        <ul>{tools.map((t) => <li>{t}</li>)}</ul>
      </>
    )}

    {(github || live) && (
      <>
        <h2>Links</h2>
        <p class="links">
          {live && <a href={live}>Try it live</a>}
          {github && <a href={github}>View on GitHub</a>}
        </p>
      </>
    )}
  </article>
</Base>
