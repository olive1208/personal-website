---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import PostList from '../components/PostList.astro';
import { contact, site } from '../site.config';
import { findImage, getPosts, getProjects } from '../lib';

const headshot = findImage('', 'headshot');
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const recent = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="intro">
    {headshot ? (
      <img class="photo" src={headshot} alt={`Photo of ${site.name}`} width="260" height="325" />
    ) : (
      <div class="photo photo-placeholder">Add your photo at<br />public/headshot.jpg</div>
    )}
    <div>
      <h1>{site.name}</h1>
      <p>
        I’m an MBA student at Berkeley Haas. I started my career in growth equity at Hillhouse Capital,
        investing in SaaS and internet platforms, including RedNote, Lalatech, and Tuya. To see the other
        side of the table, I joined the early team at Keeta, a food delivery platform, in São Paulo. There
        I worked on market entry, pricing, and merchant sales operations.
      </p>
      <p>
        At Berkeley, I’m diving into the AI ecosystem, especially AI in the physical world, and learning
        how to build with AI myself. I’m also a venture fellow at the Berkeley SkyDeck accelerator, building
        my thesis on the hardware, data and deployment layers of physical AI. If any of this interests you,
        I’d love to connect.
      </p>
      <ul class="contact-links">
        <li><span class="label">LinkedIn</span><a href={contact.linkedin}>olive-ge-li</a></li>
        <li><span class="label">GitHub</span><a href={contact.github}>olive1208</a></li>
        <li><span class="label">Email</span><span class="email">{contact.email}</span></li>
      </ul>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <h2>Selected projects</h2>
      <ProjectGrid projects={featured} />
      <p class="more"><a href="/projects/">All projects →</a></p>
    </section>
  )}

  <section class="section">
    <h2>Recent writing</h2>
    {recent.length > 0 ? (
      <>
        <PostList posts={recent} showCategory />
        <p class="more"><a href="/writing/">All writing →</a></p>
      </>
    ) : (
      <p class="empty">TBD. First posts coming soon.</p>
    )}
  </section>
</Base>
