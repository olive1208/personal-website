---
import type { CollectionEntry } from 'astro:content';
import { findImage } from '../lib';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p) => {
    const img = findImage('projects', p.id);
    return (
      <a class="tile" href={`/projects/${p.id}/`}>
        {img ? (
          <img class={img.endsWith('.gif') ? 'thumb pixel' : 'thumb'} src={img} alt={`Screenshot of ${p.data.title}`} loading="lazy" decoding="async" />
        ) : (
          <div class="thumb photo-placeholder">{p.data.title}</div>
        )}
        <h3>{p.data.title}</h3>
        <p>{p.data.summary}</p>
      </a>
    );
  })}
</div>
